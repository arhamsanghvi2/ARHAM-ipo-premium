# Copy this file to .env.local for local dev, and set the same keys in your
# hosting provider's environment variables for production (e.g. Vercel
# Project Settings -> Environment Variables). Never commit real values.

# Secret used to sign/verify login session JWTs. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=

# Login credentials for the dashboard.
ADMIN_USERNAME=
ADMIN_PASSWORD=
